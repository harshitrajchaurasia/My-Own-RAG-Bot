# \u2500\u2500 QuillShift Configuration \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Choose your LLM provider: "gemini" or "openai"
# If not set, the app auto-detects based on which API key is available.
# When both keys are set, Gemini models are tried first (free tier),
# then falls back to OpenAI automatically on rate limits.
# LLM_PROVIDER=gemini

# Google Gemini (free tier \u2014 no billing required)
# Get your free API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (requires a paid API key)
# OPENAI_API_KEY=your_openai_api_key_here

# --- Rate Limiting (optional, sane defaults built in) -----------------
# SESSION_RPM=20          # Max requests per session per minute
# GLOBAL_RPD=1000         # Max global requests per day
# SESSION_TTL_HOURS=2     # Hours before idle sessions are cleaned up

# --- Login (optional) --------------------------------------------------
# Set both to put the whole app behind a sign-in page (/login). Empty = open.
# Use a random password, e.g. python -c "import secrets;print(secrets.token_urlsafe(18))"
# LOGIN_USER=
# LOGIN_PASS=
